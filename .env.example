# ==========================================
# CashPilot - Environment Configuration
# Copy to .env and fill in your values
# ==========================================

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
# MongoDB Atlas (free tier) or local
MONGODB_URI=mongodb://localhost:27017/cashpilot
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cashpilot

# --- Current Bank Balance (for forecasting) ---
CURRENT_BANK_BALANCE=50000

# --- WhatsApp (Twilio Conversations API) ---
# Get from: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Twilio sandbox number
# For production: your approved WhatsApp Business number

# WhatsApp Template SIDs (create in Twilio Console → Content Template Builder)
# Template 1: Initial invoice
TWILIO_TEMPLATE_INVOICE_INITIAL=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Template 2: Reminder
TWILIO_TEMPLATE_INVOICE_REMINDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Template 3: Overdue
TWILIO_TEMPLATE_INVOICE_OVERDUE=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Payment Gateway (Razorpay) ---
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret  # Set in Razorpay webhook settings

# --- Optional: Stripe (for international) ---
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Frontend URL (for CORS, webhook callbacks) ---
FRONTEND_URL=http://localhost:3000

# --- Optional: Sentry Error Tracking ---
# SENTRY_DSN=https://xxx@sentry.io/xxx